# 出云 ROS2 机器人社区 环境变量示例
# 复制为 .env 并填入实际值（.env 不提交到版本库）

# 数据库连接
# 本地开发（SQLite）：file:./dev.db
# 服务器部署（PostgreSQL）：postgresql://user:password@host:5432/chuyun?schema=public
DATABASE_URL="file:./dev.db"

# 会话加密密钥（生产环境务必改为随机长字符串）
SESSION_SECRET="change-me-in-production"

# 站点地址（生产环境设为你的域名，如 https://maturo.cn）
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
